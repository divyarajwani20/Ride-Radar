# RideRadar Environment Configuration Example
# Copy to .env for local overrides

# App Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Demo Mode (Enabled by default, requires no paid API keys)
DEMO_MODE=true
DEFAULT_CITY=Jaipur
ACTIVE_DEMO_SCENARIO=scenario_1_successful_match

# Database Configuration
DATABASE_URL=sqlite:///./rideradar.db

# Provider Integration Credentials (Optional: Leave empty for honest "Not connected" / "Demo" status)
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
OLA_API_KEY=
RAPIDO_API_KEY=

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
